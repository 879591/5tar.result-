# ==============================================================================
# 5tarResult Portal - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# On Vercel: Add these under Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Supabase Public Credentials (Client-Safe)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (Existing Project: satumsjfmpbjofhixkdi)
NEXT_PUBLIC_SUPABASE_URL=https://satumsjfmpbjofhixkdi.supabase.co

# Your Supabase Publishable / Anonymous Key
# Location: Supabase Dashboard -> Project Settings -> API -> Project API keys -> "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 2. Supabase Elevated Server Secret (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Your Supabase Service Role Key for administrative backend operations bypassing RLS
# Location: Supabase Dashboard -> Project Settings -> API -> Project API keys -> "service_role secret"
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. Fast2SMS Real OTP Gateway Secret (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Fast2SMS API Key for real SMS delivery to Indian mobile numbers (+91)
# Location: Fast2SMS Dashboard (fast2sms.com) -> Dev API -> Authorization Key
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ------------------------------------------------------------------------------
# 4. AI Exam Desk / Gemini API Secret (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Google Gemini API key for student exam assistant & syllabus queries
# Location: Google AI Studio -> Get API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. Production Domain / Site URL (Client-Safe)
# ------------------------------------------------------------------------------
# Used for canonical URLs, XML sitemaps, robots.txt, and OpenGraph sharing
NEXT_PUBLIC_SITE_URL=https://5tarresult.com

# ------------------------------------------------------------------------------
# 6. Admin Panel Security Passcode (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Secure custom passcode to authenticate the /admin portal.
# DO NOT use "admin5star" or default dictionary words in production!
# Example of a strong passcode: 5tarResult_Suraj#2026_SecureAdmin!
ADMIN_PASSCODE=your_strong_admin_passcode_here
